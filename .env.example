# Frontend (public) configuration. Everything here ends up in the browser bundle — NEVER put secrets here.
# Leave VITE_API_URL empty to call the API on the same origin: in development the Vite dev server
# proxies /api and /socket.io to http://localhost:4000 (override with VITE_DEV_API_PROXY);
# in Docker, nginx proxies them to the api container. Set it only if the API lives on another origin.
VITE_API_URL=
# Map tiles. OpenStreetMap's public tile server is for light use only; use a provider that permits production traffic.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
